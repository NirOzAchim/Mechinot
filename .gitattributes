# ============================================================
#  סופי שורה — ⚠⚠⚠ הקובץ הזה מונע משפחת באגים שלמה
# ------------------------------------------------------------
#  git בווינדוס ממיר LF ל-CRLF בצ׳ק-אאוט כברירת מחדל. במערכת
#  הקודמת זה עלה ביום עבודה שלם: סקריפט שחיפש `;\n` לא תפס
#  כלום ב-`;\r\n`, כל החלפה **הוסיפה** הצהרה שנייה במקום
#  להחליף, נוצרו שני export לאותו שם, קובץ שלם הפסיק להיטען,
#  וכל מסך במערכת החזיר 500 — כולל מסכים שאין להם שום קשר.
#
#  ⚠ ואף שלב בשרשרת לא צעק. הסקריפט יצא 0 והדפיס «נכתב».
#
#  הכפייה כאן היא ההגנה היחידה שמונעת את כל המשפחה מלכתחילה.
# ============================================================

* text=auto eol=lf

*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yml   text eol=lf

# ⚠ ההפך, ובכוונה: cmd.exe דורש CRLF ונכשל **בשקט** בלעדיו —
#   הקובץ פשוט לא עושה כלום, בלי שום הודעת שגיאה.
*.cmd   text eol=crlf
*.bat   text eol=crlf

# בינאריים — לא לגעת
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
