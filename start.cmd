@echo off
chcp 65001 >nul 2>&1
cd /d "%~dp0"
title Mechinot

rem ============================================================
rem   הדבר היחיד שצריך להריץ
rem   ------------------------------------------------------------
rem   לחיצה כפולה עושה הכול: מושך את הקוד האחרון, מתקין מה
rem   שחסר, מנקה את מטמון Vite, מרים את השרת ופותח את הדפדפן.
rem
rem   ~~ ולמה הכול כאן ולא בהוראות ~~
rem   ארבע פקודות שצריך לזכור את הסדר שלהן הן ארבע הזדמנויות
rem   להיתקע, ובכל אחת הודעת השגיאה מדברת על משהו אחר מהסיבה
rem   האמיתית. קובץ אחד הוא מה שאפשר לזכור.
rem
rem   ~ npm.cmd ולא npm, ופקודה אחת בכל שורה ~
rem     ExecutionPolicy חוסמת את npm.ps1, ו-cmd.exe אינו מקבל &&.
rem   ~ ובלי ציורי מסגרת ~
rem     טקסט עברי בתוך מסגרת ASCII לעולם אינו מיושר, והתוצאה
rem     נראית שבורה. שורות מקף עובדות בכל מסך.
rem ============================================================

echo.
echo   ==========================================
echo      M E C H I N O T
echo   ==========================================
echo.

rem ============================================================
rem  0. השרת כבר רץ?
rem  ------------------------------------------------------------
rem  ~~ ולמה זה עוצר ולא פותח את הדפדפן ~~
rem  הגרסה הראשונה כאן ראתה פורט תפוס, אמרה "כבר רץ" ופתחה
rem  את הדפדפן. זה היה **הדבר הלא נכון בדיוק אחרי עדכון**:
rem  Vite מגיש את קבצי המסך מהדיסק, ותהליך ה-Node טוען את
rem  המסלולים שלו בעלייה - ולכן הדפדפן קיבל מסך חדש מול שרת
rem  ישן, והתשובה הייתה "אין נקודת קצה בשם admin/state".
rem  הודעה שמתארת את הסימפטום במדויק ושולחת לחפש באג שאין.
rem
rem  שרת שרץ מלפני המשיכה הוא המקרה הנפוץ ולא החריג, ולכן
rem  ברירת המחדל היא לעצור ולומר.
rem ============================================================
rem  ~ goto ולא בלוק בסוגריים ~
rem    choice ותנאים בתוך בלוק אחד הם מקור קבוע לבאגים ב-batch.
rem    תווית נפרדת עולה שתי שורות ועובדת תמיד.
netstat -ano | findstr ":5180 " | findstr "LISTENING" >nul 2>&1
if not errorlevel 1 goto running
goto notrunning

:running
echo.
echo   ! כבר רץ שרת על פורט 5180, בחלון אחר.
echo.
echo     אם משכת עכשיו קוד חדש - השרת ההוא ישן,
echo     והמסך יראה "אין נקודת קצה בשם ...".
echo.
echo     מה לעשות: לסגור את החלון ההוא, או Ctrl+C בתוכו,
echo     ואז להריץ את start.cmd שוב.
echo.
echo   ------------------------------------------
echo      1  לפתוח את הדפדפן על השרת שכבר רץ
echo      2  לצאת, כדי לסגור את החלון ההוא
echo   ------------------------------------------
echo.
choice /c 12 /n /m "   מה לעשות?  "
if errorlevel 2 goto bye
start http://localhost:5180/console

:bye
exit /b 0

:notrunning

rem ---------- 1. מושכים את הקוד האחרון ----------
where git >nul 2>&1
if errorlevel 1 goto skipgit

echo   [1/4] מושך את הקוד האחרון...

rem  ~~ ושמירה שקטה היא לא שמירה ~~
rem  שינוי מקומי חוסם את git pull בהודעה שאינה מסבירה דבר,
rem  והעותק נשאר מאחור. stash הפיך; מי שלא יודע שהשינוי שלו
rem  הוזז לא ילך לחפש אותו, ולכן זה נאמר.
set MX_STASHED=
for /f "delims=" %%i in ('git status --porcelain 2^>nul') do set MX_STASHED=1
if defined MX_STASHED (
  git stash push -u -m "start.cmd" >nul 2>&1
  echo.
  echo   ^! היו שינויים מקומיים והם הוזזו הצידה כדי לאפשר את המשיכה.
  echo     להחזרה:  git stash pop
  echo.
)

git pull --ff-only 2>nul
if errorlevel 1 (
  echo   ^! לא הצלחתי למשוך. ממשיכים עם מה שיש במחשב.
)
goto aftergit

:skipgit
echo   [1/4] git לא מותקן - מדלג על המשיכה.

:aftergit

rem ---------- 2. התקנה ----------
if not exist node_modules (
  echo   [2/4] מתקין חבילות. פעם ראשונה, כדקה...
  call npm.cmd install
) else (
  echo   [2/4] החבילות מותקנות.
)

rem ---------- 3. מטמון Vite ----------
rem  ~~ קובץ מקור חדש, ומטמון שמחזיק ישן ~~
rem  node_modules\.vite מחזיק חבילה שנבנתה לפני שהקובץ היה
rem  קיים, וה-import שלו נופל ב-ReferenceError אף שהקוד תקין
rem  לחלוטין: הבנייה עוברת, והדפדפן מציג מסך לבן. מחיקה כאן
rem  עולה שנייה ומונעת שעה.
echo   [3/4] מנקה מטמון...
if exist node_modules\.vite rmdir /s /q node_modules\.vite

rem ---------- 4. שרת, ואז דפדפן ----------
rem  ~ הדפדפן נפתח אחרי שהשרת עונה ולא יחד איתו ~
rem    פתיחה מיד נותנת "לא ניתן להתחבר", ומי שרואה את זה
rem    מסיק שזה נשבר.
echo   [4/4] מרים את השרת...
echo.
echo   ------------------------------------------
echo     הקונסולה נפתחת בדפדפן בעוד כמה שניות:
echo     http://localhost:5180/console
echo.
echo     בכניסה הראשונה היא תבקש להקים מנהל-על:
echo     שם משתמש וסיסמה שאתה בוחר.
echo   ------------------------------------------
echo.
echo   לעצירה: Ctrl+C, או לסגור את החלון.
echo.

start "" cmd /c "timeout /t 7 >nul & start http://localhost:5180/console"

call npm.cmd run dev

echo.
echo   השרת נעצר.
pause
