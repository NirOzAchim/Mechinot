@echo off
cd /d "%~dp0"
if not exist node_modules ( call npm.cmd install )

rem ============================================================
rem  ~ אין זריעה שקטה ~
rem  ------------------------------------------------------------
rem  הגרסה הקודמת הריצה "npm run seed" בשקט כשחסרה .data,
rem  ולכן מי שציפה למכינה אחת קיבל אחרת - בלי שום רמז.
rem  היום השרת עצמו מדפיס בעלייה אילו מכינות נטענו, והפקודות
rem  להקמה מודפסות כאן ואינן רצות מעצמן.
rem ============================================================
if not exist .data (
  echo.
  echo   אין עדיין נתונים. אחרי שהשרת יעלה:
  echo     http://localhost:5180/console    - הקמת מנהל-על ומכינה
  echo   או בשורת פקודה, בחלון נוסף:
  echo     npm run seed                     - מכינה מלאה לבדיקה
  echo.
)

call npm.cmd run dev
pause
